# syntax=docker/dockerfile:1
#
# Test-runner image for the image-based §18 ACC-01 acceptance runs (M8 exit
# check). Built FROM a platform-specific runtime image; adds only the locked
# dev tooling (pytest + pytest-asyncio) on top of the exact runtime venv, so
# the acceptance suite executes against the shipped runtime contents.
#
# Usage (from the repo root, per platform):
#   docker buildx build --platform linux/amd64 \
#     --build-arg BASE_IMAGE=agentbase:amd64 -t agentbase-test:amd64 -f Dockerfile.test .
#   docker run --rm --platform linux/amd64 \
#     -v "$(pwd)":/repo:ro -w /repo agentbase-test:amd64 tests -q -p no:cacheprovider
#
# The repo is mounted read-only; pytest writes only to tmpfs (/tmp, group
# writable per CNT-03). pyproject.toml supplies pytest config (asyncio_mode).
ARG BASE_IMAGE=agentbase:amd64
FROM ${BASE_IMAGE}

USER root
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

# The runtime image drops pip (CNT-01/12); the test image needs it back to
# install the locked dev tooling. ensurepip's bundled pip is hash-verified by
# the python distribution itself; the dev lock install then stays hash-pinned.
# (Invoke via ``python -m pip``: ensurepip may recreate only pip3/pip3.12.)
RUN python -m ensurepip --upgrade

COPY requirements-dev.lock /build/requirements-dev.lock
RUN python -m pip install --require-hashes -r /build/requirements-dev.lock \
    && python -m pip check

WORKDIR /repo
ENTRYPOINT ["python", "-m", "pytest"]
