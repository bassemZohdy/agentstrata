# Sample MCP stdio server used by docker-compose (CNT-09).
#
# The server script is NOT copied at build time: the repo's .dockerignore
# excludes scripts/ from build contexts (CNT-01), so docker-compose.yaml
# mounts ./scripts read-only at /srv instead.

FROM python:3.12-slim
RUN pip install --no-cache-dir "mcp>=1.24,<2"
WORKDIR /srv
CMD ["python", "/srv/spike_mcp_server.py"]
